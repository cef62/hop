<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- LaunchServices starts hop as an agent app; lib.rs sets the same Accessory policy before tao finishes launching -->
	<key>LSUIElement</key>
	<true/>
	<!-- the Automation prompt's text, shown on the first Empty Trash (Finder) and, if macOS asks, Restart/Shut Down/Log Out -->
	<key>NSAppleEventsUsageDescription</key>
	<string>hop empties the Trash and asks macOS to restart, shut down or log out when you choose those commands.</string>
</dict>
</plist>
