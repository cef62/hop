---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import icon from '../../../src-tauri/icons/icon.png';
import { getDownload } from '../lib/release';

const dl = await getDownload();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const features = [
  { title: 'One shortcut', text: 'Press ⌥Space over any app. Press it again to hide.' },
  { title: 'Finds apps as you type', text: 'Search by name or by initials: vsc finds Visual Studio Code.' },
  { title: 'Quick maths', text: 'Type 2+3*4 to see 14, press Enter to copy it.' },
  { title: 'Stays out of the way', text: 'No Dock icon. Esc returns you to the app you were in.' },
  { title: 'Updates itself', text: 'hop tells you about a new version and installs it when you say so.' },
];
---

<Base title="hop — a minimal app launcher for macOS">
  <section class="hero">
    <img class="app-icon" src={icon.src} width="96" height="96" alt="" />
    <h1>hop</h1>
    <p class="lede">A minimal app launcher for Apple silicon Macs. Press <kbd>⌥Space</kbd>, type, press <kbd>Enter</kbd>.</p>
    <p>
      <a class="button" href={dl.dmg}>Download for macOS{dl.version ? ` (v${dl.version})` : ''}</a>
    </p>
    <p class="muted">
      Apple silicon only. hop is not signed with an Apple Developer ID, so macOS blocks the first launch:{" "}
      <a href={`${base}/usage/#install`}>install steps and the Gatekeeper workaround</a>.
    </p>
  </section>

  <Shot name="palette-results" alt="The hop palette with the query “sa”, listing Safari and Messages." priority />

  <ul class="cards">
    {features.map((f) => (
      <li>
        <h2>{f.title}</h2>
        <p>{f.text}</p>
      </li>
    ))}
  </ul>
</Base>
