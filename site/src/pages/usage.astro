---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';

// Keep in step with README.md (the GitHub-facing copy of the same facts).
const toc = [
  ['install', 'Install'],
  ['open', 'Open hop'],
  ['search', 'Search and launch'],
  ['system-settings', 'System Settings'],
  ['system-commands', 'System commands'],
  ['calculator', 'Calculator'],
  ['shortcuts', 'Keyboard shortcuts'],
  ['settings', 'Settings'],
  ['updates', 'Updates'],
];
const keys = [
  ['⌥Space', 'Show the palette over any app; press again to hide. Default hotkey.'],
  ['↑ ↓', 'Select a result.'],
  ['Enter', 'Open the selected app or System Settings section, or run the selected command.'],
  ['Enter, then Enter', 'Restart, Shut Down, Log Out or Empty Trash: the first arms the command, the second runs it. Any other key cancels.'],
  ['⌘Enter', 'Reveal the selected app in Finder. On a System Settings section, open it.'],
  ['⌘1 … ⌘9', 'Open the Nth result directly. Hold ⌘ to see the numbers.'],
  ['Enter on a result', 'Copy the calculator’s answer and hide the palette.'],
  ['Enter on a history row', 'Put that past sum in the field to edit. ⌘Enter inserts its result after an operator (1+), or in place of = or an empty field.'],
  ['Esc', 'Hide the palette and return to your app. Also closes Settings.'],
  ['⌘,', 'Open Settings from the palette.'],
  ['⌘U', 'Open What’s new when an update pill shows.'],
];
---

<Base title="Usage · hop" description="Install hop, and use its shortcuts, Settings and updates.">
  <div class="doc">
    <nav class="toc" aria-label="On this page">
      <p>On this page</p>
      <ol>
        {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
      </ol>
    </nav>

    <article class="prose">
      <h1>Usage</h1>

      <section id="install">
        <h2>Install</h2>
        <ol>
          <li>Download <code>hop_&lt;version&gt;_aarch64.dmg</code> from the <a href="https://github.com/cef62/hop/releases/latest">latest release</a>.</li>
          <li>Open the dmg and drag hop to Applications.</li>
          <li>Open hop from Applications. macOS blocks the first launch.</li>
          <li>Allow it once, with either of these:
            <ul>
              <li>System Settings › Privacy &amp; Security, then <strong>Open Anyway</strong> next to hop.</li>
              <li>Or run this, then open hop again:
                <pre><code>xattr -dr com.apple.quarantine /Applications/hop.app</code></pre>
              </li>
            </ul>
          </li>
        </ol>
        <p class="note">hop is not signed with an Apple Developer ID, hence the block. Later versions install from inside hop and need neither step.</p>
      </section>

      <section id="open">
        <h2>Open hop</h2>
        <p>hop has no Dock icon. Use either of these:</p>
        <ul>
          <li>Press <kbd>⌥Space</kbd>, the default hotkey.</li>
          <li>Click the menu-bar icon, then <strong>Open hop</strong>.</li>
        </ul>
        <p>The palette shows on the screen under the mouse. Opening the hop app again while it runs shows it too.</p>
        <p>The menu-bar icon also opens <strong>Settings…</strong> and quits hop. It stays there when another app holds the hotkey.</p>
      </section>

      <section id="search">
        <h2>Search and launch</h2>
        <Shot name="palette-empty" alt="The hop palette with nothing typed, listing the most used apps." caption="Nothing typed: your most used apps." />
        <ul>
          <li>Type to find an app by name, by its English file name, or by initials.</li>
          <li><code>vsc</code> finds Visual Studio Code.</li>
          <li>Apps you open often rank higher.</li>
          <li>Press <kbd>Enter</kbd> to open, <kbd>⌘Enter</kbd> to reveal in Finder.</li>
          <li>Hold <kbd>⌘</kbd> to see numbers on the first nine results, then press <kbd>⌘1</kbd> to <kbd>⌘9</kbd> to open one.</li>
        </ul>
        <Shot name="palette-results" alt="The hop palette with the query “sa”, listing Safari, Messages, the Restart command and the Displays section of System Settings." caption="Typing “sa”." />
        <Shot name="palette-cmd" alt="The hop palette with the query “ma” while ⌘ is held: Mail, Maps, Messages, Terminal and Empty Trash show ⌘1 to ⌘5 at the right of each row." caption="Holding ⌘ shows the number keys." />
        <h3>Where hop looks</h3>
        <ul>
          <li><code>/Applications</code>, <code>/System/Applications</code>, their <code>Utilities</code> folders and <code>~/Applications</code>.</li>
          <li>One folder deep, so vendor folders work.</li>
          <li>New and removed apps are picked up by themselves.</li>
        </ul>
        <p>Press <kbd>Esc</kbd> or click away to hide the palette. Focus returns to the app you were in.</p>
      </section>

      <section id="system-settings">
        <h2>System Settings</h2>
        <Shot name="palette-settings" alt="The hop palette with the query “priv”: one row, Privacy & Security, with the System Settings icon and a “System Settings” tag at the right." caption="Typing “priv” finds the Privacy & Security section." />
        <ul>
          <li>Type a section's name to find it, such as <code>privacy</code> for Privacy &amp; Security or <code>storage</code> for General › Storage.</li>
          <li>Press <kbd>Enter</kbd> to open System Settings on that section.</li>
          <li>Sections match by their name in each of your Mac's languages and in English.</li>
          <li>Section rows show the System Settings icon and a "System Settings" tag. They rank with the apps, and sections you open often rank higher.</li>
        </ul>
      </section>

      <section id="system-commands">
        <h2>System commands</h2>
        <Shot name="palette-armed" alt="The hop palette with the query “restart”: the Restart row now reads “Press Enter again to restart”, with “Enter confirm” at its right." caption="After the first Enter on Restart: press Enter again to confirm." />
        <ul>
          <li>Type a command's name: Lock Screen, Sleep, Restart, Shut Down, Log Out or Empty Trash.</li>
          <li>Other names work too: <code>lock</code>, <code>reboot</code>, <code>shutdown</code>, <code>power off</code>, <code>logout</code>, <code>sign out</code> and <code>trash</code>. Names are English only.</li>
          <li>Lock Screen and Sleep run when you press <kbd>Enter</kbd>.</li>
          <li>Restart, Shut Down, Log Out and Empty Trash need a second <kbd>Enter</kbd>. The first one changes the row to “Press Enter again to restart” (or shut down, log out, empty the Trash).</li>
          <li>Any other key, a click or a new query cancels. <kbd>⌘Enter</kbd> and <kbd>⌘1</kbd> to <kbd>⌘9</kbd> can ask, but never confirm.</li>
          <li>Commands never show in the list of most used items you see with nothing typed, so a stray <kbd>Enter</kbd> there never runs one.</li>
          <li>Apps with unsaved work can still stop a restart, shut down or log out.</li>
          <li>Commands rank with the apps, and commands you use often rank higher.</li>
        </ul>
        <p class="note">The first Empty Trash asks you to let hop control Finder; macOS may ask the same for Restart, Shut Down and Log Out. hop is not signed with an Apple Developer ID, so macOS may ask again after an update. You can change your answer in System Settings › Privacy &amp; Security › Automation.</p>
        <p>To keep commands out of the palette, turn off <strong>System commands</strong> in Settings.</p>
      </section>

      <section id="calculator">
        <h2>Calculator</h2>
        <Shot name="palette-calc" alt="The hop palette with the query “12*7+3”: the first row shows the answer, “= 87”, with “Enter copy” at its right." caption="Typing a sum: the answer is the first row." />
        <ul>
          <li>Type a sum such as <code>2+3*4</code>. The answer, <code>= 14</code>, shows above the apps.</li>
          <li>It takes <code>+ - * / % ^</code> (<code>%</code> is the remainder), parentheses, and decimals with a <code>.</code>. <code>×</code> and <code>÷</code> work too.</li>
          <li>Press <kbd>Enter</kbd> or <kbd>⌘1</kbd> to copy the answer. The palette hides, so you can paste it in your app.</li>
          <li>A bare number such as <code>2024</code> stays an app search, and so does <code>1password</code>.</li>
          <li>Numbers can carry an exponent, like <code>1.2e+21</code>, so any answer you see can be typed back in.</li>
          <li>Whole numbers up to 9007199254740991 are exact. Other answers round to 12 significant digits. Very large or small answers show in exponent form, like <code>9.00719925474e+15</code>, so a rounded answer never looks exact.</li>
        </ul>
        <h3>History</h3>
        <Shot name="palette-history" alt="The hop palette with the query “=”: five past sums, each as an expression, an equals sign and its result, such as “12*7+3 = 87”, with “Enter edit” at the right of the first." caption="Typing = lists your copied results." />
        <ul>
          <li>hop keeps the last 20 results you copied. Under a sum, up to 5 of the latest show below its answer (not the one you are typing), as <code>expression = result</code>. <code>2+2</code> and <code>2 + 2</code> are one entry.</li>
          <li>Type <code>=</code> alone to see all 20.</li>
          <li><kbd>Enter</kbd> (or <kbd>⌘1</kbd> to <kbd>⌘9</kbd>, or a click) on a history row puts its expression in the field, so you can edit it. The palette stays open.</li>
          <li><kbd>⌘Enter</kbd> inserts its result. After an operator, <code>1+</code> becomes <code>1+87</code> (a sum that waits for its last number lists history too). On <code>=</code> or an empty field, the result replaces it. Under a complete sum or a number there is no place for it, so <kbd>⌘Enter</kbd> does nothing and the palette does not offer it.</li>
          <li>Only a copy is kept, and a sum you copy again moves to the top.</li>
          <li>To turn the answer and the history off, turn off <strong>Calculator</strong> in Settings. <code>=</code> then searches like any other text.</li>
        </ul>
      </section>

      <section id="shortcuts">
        <h2>Keyboard shortcuts</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Key</th><th scope="col">Does</th></tr></thead>
            <tbody>
              {keys.map(([k, d]) => <tr><th scope="row"><kbd>{k}</kbd></th><td>{d}</td></tr>)}
            </tbody>
          </table>
        </div>
      </section>

      <section id="settings">
        <h2>Settings</h2>
        <p>Open it with <kbd>⌘,</kbd> in the palette, or from the menu-bar icon. Changes apply at once.</p>
        <Shot name="settings" alt="The hop Settings window." caption="Settings." narrow />
        <ul>
          <li><strong>Hotkey:</strong> click it, press a new chord. <kbd>⌫</kbd> removes it, <kbd>Esc</kbd> cancels.</li>
          <li><strong>Start at login:</strong> on by default.</li>
          <li><strong>Extra folders to index:</strong> more places to look for apps.</li>
          <li><strong>Ignored apps:</strong> apps to hide from the palette.</li>
          <li><strong>System commands:</strong> Lock Screen, Sleep, Restart and the others in the palette. On by default.</li>
          <li><strong>Calculator:</strong> the answer to a sum and the history under it. On by default.</li>
          <li><strong>Theme:</strong> System, Light or Dark.</li>
          <li><strong>Palette style:</strong> Compact or Roomy.</li>
          <li><strong>Check every day:</strong> look for updates automatically.</li>
        </ul>
        <p class="note">If another app (Raycast, Alfred) uses the same hotkey, both respond. Change one of them.</p>
      </section>

      <section id="updates">
        <h2>Updates</h2>
        <ul>
          <li>With <strong>Check every day</strong> on, hop checks 30 seconds after it starts, then once a day.</li>
          <li><strong>Check now</strong> in Settings and <strong>Check for Updates…</strong> in the menu-bar icon check at once.</li>
          <li>hop never interrupts you. A found update shows as a small pill in the palette footer, and as <strong>Update to hop X…</strong> in the menu-bar icon.</li>
          <li>Click the pill or press <kbd>⌘U</kbd> to open What’s new.</li>
        </ul>
        <Shot name="whatsnew" alt="The What’s new window with release notes and an Install and restart button." caption="What’s new." narrow />
        <ul>
          <li>Read the release notes, then click <strong>Install and restart</strong>.</li>
          <li>Updates are verified against hop’s signing key before they install.</li>
          <li>After the restart, hop stays hidden until you call it.</li>
        </ul>
      </section>
    </article>
  </div>
</Base>
